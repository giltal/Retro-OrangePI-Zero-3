#!/bin/sh
#
# Audio setup: pick the output card, put a software volume control in front of
# it, and restore the saved level.
#
# WHY SOFTVOL. On the reference board (A33) the volume was the codec's analog
# 'Headphone Playback Volume'. HDMI has no analog stage, and the H616
# audio-hub driver (kernel patches 0043/0044, vendored from Armbian) exposes
# controls that depend on that patch set. So instead of chasing a hardware
# control, /etc/asound.conf gets a softvol 'Master' control in front of the
# card. It has 101 steps: index == launcher percent, and 0 is mute. The launcher
# and volumed both drive only that control.
#
# WHICH CARD. The Zero3 registers up to two: the audio-hub card that feeds HDMI,
# and the analog codec that feeds LINEOUT on the 13-pin header. Card index
# order is probe order, which is not a contract, so match on the NAME in
# /proc/asound/cards. HDMI is preferred because the console lives on a TV.
#
# Force a card by putting its number in /opt/roms/_system/audio_card (a single
# digit). That file is on the FAT partition, so it can be edited from a PC if the
# automatic choice is wrong.
#
# LESSONS CARRIED OVER (reference S35alsa):
#  - `alsactl restore` says OK while faithfully restoring a MUTED snapshot. So
#    verify the result, don't trust the exit code.
#  - check the WHOLE playback path. One muted stage anywhere silences everything
#    downstream, and nothing complains.
#
# S11, not S35 as on the reference: the launcher (S12) applies the saved volume
# the moment it starts, so the Master control has to exist by then. udev (S10)
# has already triggered and settled, so /dev/snd is there.

CONF=/etc/asound.conf
OVERRIDE=/opt/roms/_system/audio_card
DEFAULT_PCT=40

pick_card() {
	if [ -r "$OVERRIDE" ]; then
		c=$(tr -dc '0-9' < "$OVERRIDE" | cut -c1)
		[ -n "$c" ] && [ -d "/proc/asound/card$c" ] && { echo "$c"; return; }
	fi
	# Lines look like: " 0 [ahubhdmi       ]: ahub_plat - ahubhdmi"
	c=$(grep -i 'hdmi' /proc/asound/cards 2>/dev/null | sed -n 's/^ *\([0-9]\+\) .*/\1/p' | head -1)
	[ -n "$c" ] && { echo "$c"; return; }
	c=$(sed -n 's/^ *\([0-9]\+\) .*/\1/p' /proc/asound/cards 2>/dev/null | head -1)
	echo "${c:-0}"
}

write_conf() {
	card="$1"
	tmp="$CONF.tmp"
	cat > "$tmp" <<EOF
# GENERATED by /etc/init.d/S35alsa at boot -- edits here are overwritten.
# Output card $card: $(sed -n "s/^ *$card \[\([^]]*\)\].*/\1/p" /proc/asound/cards | tr -d ' ')
#
# default -> plug (rate/format conversion) -> softvol 'Master' -> hw
pcm.!default {
	type plug
	slave.pcm "retroopi_softvol"
}
pcm.retroopi_softvol {
	type softvol
	slave.pcm "hw:$card,0"
	control {
		name "Master"
		card $card
	}
	min_dB -40.0
	max_dB 0.0
	resolution 101
}
ctl.!default {
	type hw
	card $card
}
EOF
	# Rewrite only on change: this lives on the rootfs, and an fsync'd write
	# on every boot is a cost the reference measured and removed elsewhere.
	if cmp -s "$tmp" "$CONF"; then rm -f "$tmp"; else mv "$tmp" "$CONF"; fi
}

vol_get() {
	amixer cget name='Master Playback Volume' 2>/dev/null \
		| sed -n 's/.*: values=\([0-9]*\).*/\1/p' | head -1
}

case "$1" in
	start)
		printf "Audio: "
		if ! grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; then
			echo "FAIL (no sound cards)"
			exit 0
		fi
		card=$(pick_card)
		write_conf "$card"
		printf "card %s, " "$card"

		# softvol creates its control on the first open of the PCM. Play 0.1 s
		# of silence through it, so the control exists before we restore it and
		# before the launcher asks for it. Raw from a pipe, so it ends by itself.
		# busybox has no `timeout` to guard a hung aplay with.
		head -c 19200 /dev/zero |
			aplay -q -D default -t raw -f S16_LE -r 48000 -c 2 >/dev/null 2>&1

		[ -f /var/lib/alsa/asound.state ] && alsactl restore >/dev/null 2>&1

		v=$(vol_get)
		if [ -z "$v" ]; then
			echo "FAIL (no Master control -- softvol did not come up)"
		elif [ "$v" -eq 0 ]; then
			# A saved mute is almost always an accident (shutdown while muted).
			# The launcher applies state.txt right after, and this is only
			# the floor for a card with no saved state.
			amixer -q cset name='Master Playback Volume' "$DEFAULT_PCT"
			echo "restored muted state, reset to $DEFAULT_PCT%"
		else
			echo "OK (Master $v%)"
		fi
		;;
	stop)
		# Persist, but never store a muted Master, or a shutdown while muted
		# poisons the next boot.
		v=$(vol_get)
		[ -n "$v" ] && [ "$v" -gt 0 ] && alsactl store >/dev/null 2>&1
		;;
	restart|reload)
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit 0
