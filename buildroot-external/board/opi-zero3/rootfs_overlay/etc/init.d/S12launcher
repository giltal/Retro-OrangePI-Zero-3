#!/bin/sh
#
# BOOT ORDER: this used to be S99 -- dead last, behind dbus, alsa, bluetoothd,
# the network, wifi, crond and dropbear. None of those are needed to draw the
# UI. The launcher's only real dependencies are /dev/dri and the input devices,
# both of which exist once udev (S10) has settled. The display and GPU drivers
# are built in. S11alsa must come first, because it creates the softvol Master
# control that the launcher sets at startup. On the reference, moving it to S12 put
# pixels on screen roughly a second earlier and let everything else finish
# behind it -- Bluetooth included, so a controller pairs a moment later than
# the menu appears, which is the right way round.
#
# Start the RetroOPI launcher -- the device's UI.
#
# S99 so it runs last: it needs /opt/roms mounted (the FAT32 ROM partition) and
# udev to have created /dev/dri/* and /dev/input/*. The launcher takes DRM master
# on the KMS node, so the framebuffer console stops updating while it runs; the
# serial console on ttyS0 is unaffected and remains available for debugging.
#
# NOT respawned on exit, deliberately. During bring-up a crash should hand the
# display back rather than spin in a restart loop that hides the failure. For a
# shipping device the respawn belongs in /etc/inittab:
#     ::respawn:/usr/bin/retroopi_launcher
# which busybox init handles, including restart-on-crash.

DAEMON="retroopi_launcher"
DAEMON_PATH="/usr/bin/$DAEMON"
PIDFILE="/var/run/$DAEMON.pid"
LOGFILE="/var/log/$DAEMON.log"

start() {
	[ -x "$DAEMON_PATH" ] || { echo "Launcher: $DAEMON_PATH missing"; return 1; }

	printf "Starting %s: " "$DAEMON"
	# Keep the log; it records which DRM node was chosen, whether a gamepad and
	# touchscreen were found, and the startup time -- all worth having after a
	# failed boot.
	#
	# The redirection must happen INSIDE the backgrounded process. busybox
	# start-stop-daemon --background points the child's stdio at /dev/null,
	# so redirecting the start-stop-daemon call itself captures nothing --
	# which is exactly what happened the first time this script ran.
	start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
		--startas /bin/sh -- -c "exec '$DAEMON_PATH' >> '$LOGFILE' 2>&1"
	status=$?
	if [ "$status" -eq 0 ]; then echo "OK"; else echo "FAIL"; fi
	return "$status"
}

stop() {
	# Verify the process is ACTUALLY gone rather than trusting the return
	# code, and never remove the pidfile unless it is. The previous version
	# did "rm -f $PIDFILE" unconditionally, so a stop that did not take left
	# the launcher running with no pidfile -- permanently unstoppable through
	# this script. That happened: the launcher kept DRM master, and every
	# subsequent RetroArch launch died with
	#     [KMS]: Error when switching mode
	#     [Video]: Cannot open video driver.. Exiting..
	# which looks like a graphics bug and is really a stale process.
	printf "Stopping %s: " "$DAEMON"

	# STOP THE GAME FIRST, and give it a chance to save.
	#
	# RetroArch is forked by the launcher and is not managed by any init script,
	# so nothing here used to touch it. Powering off DURING A GAME therefore left
	# it running with the ROM and rootfs open: inittab runs "umount -a -r" before
	# init sends its blanket SIGKILL, so the umount failed and both filesystems
	# were left dirty -- "EXT4-fs: recovery required" and the FAT dirty bit. Worse,
	# RetroArch was then SIGKILLed without flushing, so a mid-game power-off could
	# lose SRAM.
	#
	# This was missed because the earlier shutdown test was run from the MENU,
	# where only the launcher is alive and the shutdown really is clean. The bug
	# only appears the way the console is actually used.
	#
	# SIGTERM first: RetroArch commits its save files on a clean teardown. Only
	# escalate if it will not go. parallel-n64 SIGSEGVs on exit anyway, which is
	# fine here -- the saves are written before that point.
	if pidof retroarch.bin >/dev/null 2>&1; then
		printf "(saving game) "
		killall retroarch.bin 2>/dev/null
		i=0
		while pidof retroarch.bin >/dev/null 2>&1; do
			i=$((i + 1))
			[ "$i" -gt 8 ] && { killall -9 retroarch.bin 2>/dev/null; break; }
			sleep 1
		done
		sync
	fi

	[ -f "$PIDFILE" ] && start-stop-daemon --stop --quiet --pidfile "$PIDFILE"

	# Escalate: TERM by name, then KILL. The launcher holds DRM master, so a
	# survivor is not a cosmetic leak -- nothing else can draw.
	i=0
	while pidof "$DAEMON" >/dev/null 2>&1; do
		i=$((i + 1))
		[ "$i" -gt 20 ] && break
		[ "$i" -eq 1 ]  && killall "$DAEMON" 2>/dev/null
		[ "$i" -eq 10 ] && killall -9 "$DAEMON" 2>/dev/null
		sleep 1
	done

	if pidof "$DAEMON" >/dev/null 2>&1; then
		echo "FAIL (still running)"
		return 1
	fi
	rm -f "$PIDFILE"
	echo "OK"
	return 0
}

case "$1" in
	start)
		start;;
	stop)
		stop;;
	restart|reload)
		stop; sleep 1; start;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit $?
