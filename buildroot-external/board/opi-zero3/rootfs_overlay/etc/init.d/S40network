#!/bin/sh
#
# Start the network -- in the background.
#
# Overrides Buildroot's ifupdown script. `ifup -a` took 1.94 s of every boot:
# even with udhcpc backgrounding itself (-b), its foreground phase is up to
# `-t 3` attempts at `-T 1` second each before it gives up and forks.
#
# Nothing on this console needs an IP address to start a game, so waiting for
# one before showing the launcher is time spent for no user-visible benefit.
# The lease still arrives a second or two later, which is invisible in practice
# because it lands long before anyone navigates to a ROM.
#
# `stop` stays in the foreground so shutdown actually releases the lease.

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

case "$1" in
  start)
	printf "Starting network (background): "
	( /sbin/ifup -a >/dev/null 2>&1 ) &
	echo "OK"
	;;
  stop)
	printf "Stopping network: "
	/sbin/ifdown -a
	[ $? = 0 ] && echo "OK" || echo "FAIL"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
