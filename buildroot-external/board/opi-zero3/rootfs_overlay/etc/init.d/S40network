#!/bin/sh
#
# Start the network -- in the background.
#
# Overrides Buildroot's ifupdown script. `ifup -a` took 1.94 s of every boot:
# even with udhcpc backgrounding itself (-b), its foreground phase is up to
# `-t 3` attempts at `-T 1` second each before it gives up and forks.
#
# Nothing on this console needs an IP address to start a game, so waiting for
# one before showing the launcher is time spent for no user-visible benefit.
# The lease still arrives a second or two later, which is invisible in practice
# because it lands long before anyone navigates to a ROM.
#
# `stop` stays in the foreground so shutdown actually releases the lease.

# Debian ifupdown needs the /run/network lock directory
mkdir -p /run/network

case "$1" in
  start)
	printf "Starting network (background): "
	( /sbin/ifup -a >/dev/null 2>&1 ) &
	echo "OK"
	;;
  stop)
	# DO NOT take eth0 down at shutdown. (It used to be `ifdown -a`.)
	#
	# On the Zero3, bringing eth0 down ends in phy_suspend() -> BMCR_PDOWN,
	# which powers the YT8531 PHY off. The board has no PHY reset line and the
	# PHY's supply stays on across a WARM reboot, so the next kernel finds the
	# PHY still powered down, the EMAC reset waits for a clock that never comes,
	# and the board comes up with no network until it is power-cycled.
	# Measured: `reboot` -> not on the network within 180 s. Power cycle -> link
	# up at 9.4 s. Same failure and workaround as reported for Armbian/DietPi
	# on this board.
	#
	# So only release the DHCP lease and stop the clients. The link stays up
	# and the kernel resets the PHY properly on the way down.
	printf "Stopping network (eth0 left up, see S40network): "
	for pf in /var/run/udhcpc.*.pid; do
		[ -f "$pf" ] || continue
		kill -USR2 "$(cat "$pf")" 2>/dev/null	# release the lease
		sleep 1
		kill "$(cat "$pf")" 2>/dev/null
		rm -f "$pf"
	done
	killall udhcpc 2>/dev/null
	echo "OK"
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit 0
