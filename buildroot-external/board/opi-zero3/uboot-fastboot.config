# U-Boot tuning for boot time. The numbers below were measured on the
# reference board (A33, U-Boot 2026.01) and have not been re-measured here.
#
# Measured: U-Boot takes 4.11 s of a ~12 s power-on-to-login boot -- the single
# largest chunk, and previously untouched. Two costs are visible in its log:
#
#   Hit any key to stop autoboot:  2 1 0        <- 2 s of pure waiting
#   starting USB... scanning usb for storage devices... 0 Storage Device(s)
#
# We boot the kernel from MMC, so U-Boot's USB stack buys us nothing at boot.

# Autoboot delay: 2 s -> 1 s.
#
# NOT set to 0 deliberately. Interrupting autoboot to boot a different DTB by
# hand has been the recovery path several times in this project (black screen,
# bad DTB, unbootable rootfs). Losing that to save one more second is a bad
# trade while the device is still in bring-up. Revisit for production.
CONFIG_BOOTDELAY=1

# Drop USB from U-Boot entirely: host controller probe, hub enumeration, the
# storage scan, the usb_ether gadget and usbkbd. None are used to boot.
# The kernel's USB is untouched -- this is U-Boot only.
# CONFIG_USB is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_KEYBOARD is not set
# CONFIG_USB_GADGET is not set
# CONFIG_CMD_USB is not set

# No network booting either; this pulls in the ethernet gadget init.
# CONFIG_CMD_NET is not set
# CONFIG_CMD_DHCP is not set
# CONFIG_CMD_PING is not set
