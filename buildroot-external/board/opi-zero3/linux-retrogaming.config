# RetroOPI_Z3 kernel config fragment, applied on top of arch/arm64/configs/defconfig.
#
# arm64 defconfig already enables ARCH_SUNXI, MMC_SUNXI, SUN8I_THERMAL,
# CPUFREQ_DT, PHY_SUN4I_USB, NVMEM_SUNXI_SID and RTC_DRV_SUN6I. It builds most
# of the display, GPU and audio stack as modules. We pull that stack in as =y:
#
#   - the boot console appears on HDMI with no module loading involved. On the
#     reference board that was the cheapest "is the display alive" signal we
#     had, and it still is.
#   - no firmware is involved anywhere in this path, so there is none of the
#     "built-in probes before rootfs mounts" trouble that forced brcmfmac to
#     be a module on the A33 (see the reference DevelopmentLog).
#
# Values for the Allwinner-specific symbols follow Armbian's
# config/kernel/linux-sunxi64-current.config, which ships on this board.

# --- Display: DE33 mixer -> TCON-TV -> DW-HDMI --------------------------
# The H616 support for these comes from patches/linux/0001-0042 (Armbian's
# copy of the sun4i-drm refactor). Mainline 6.18 has none of the H616 nodes.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_SUN8I_DW_HDMI=y
CONFIG_DRM_SUN50I_PLANES=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
# DSI and the old sun4i HDMI block do not exist on the H618.
# CONFIG_DRM_SUN6I_DSI is not set

# fbdev emulation + framebuffer console: kernel messages on the TV before
# userspace. Cheap, and worth it during bring-up.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- GPU: Mali-G31 MP2 (Bifrost) via panfrost ---------------------------
# Render-only, like lima was on the A33: it registers its own DRM node with no
# CRTCs or connectors, and Mesa scans out through sun4i-drm via kmsro. The
# launcher and RetroArch patch 0005 already scan /dev/dri/card* for the node
# that owns a display, so which of them gets card0 does not matter.
CONFIG_DRM_PANFROST=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# The GPU's power domain: the gpu node has power-domains = <&prcm_ppu 2>,
# served by "allwinner,sun50i-h616-prcm-ppu". arm64 defconfig leaves this OFF
# (it only has the D1 PPU, SUN20I_PPU). Without it the domain stays
# "dormant", panfrost waits and then fails with "deferred probe timeout ...
# error -110" at ~16 s, no render node appears, and RetroArch dies on
# "[KMS]: Couldn't create GBM device". That was the first Zero3 boot of build #1.
CONFIG_SUN50I_H6_PRCM_PPU=y

# --- Audio --------------------------------------------------------------
# HDMI audio goes through the H616 "audio hub". Mainline has no driver for it.
# sound/soc/sunxi_v2 comes from patches/linux/0043, with the clock fix in 0044.
# AAUDIO is the analog LINEOUT on the 13-pin header; it selects
# SND_SUN4I_CODEC, which carries the H616 codec in mainline.
#
# CONFIG_SOUND is the parent of all of ALSA, and arm64 defconfig sets it to
# =m. A tristate cannot be built in under a modular parent, so without this
# line EVERY =y below silently became =m (build #1). post-build.sh now fails
# the build when a line in this fragment does not survive into .config.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SUNXI_AHUB=y
CONFIG_SND_SOC_SUNXI_AAUDIO=y
CONFIG_SND_SUN4I_I2S=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_USB_AUDIO=y
CONFIG_DMA_SUN6I=y
CONFIG_SUN50I_IOMMU=y

# --- Power / thermal ----------------------------------------------------
# The Zero3 has an AXP313a PMIC. It supplies dcdc1 to the GPU (mali-supply)
# and aldo1 to the HDMI PHY (hvcc-supply), so it must be up before either probes.
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_SUN8I_THERMAL=y
CONFIG_CPU_THERMAL=y

# --- Ethernet: the dev link ---------------------------------------------
# The Zero3 has gigabit Ethernet (Motorcomm YT8531 PHY on the H616 EMAC0).
# That replaces the reference board's USB-Ethernet dongle as the ssh/scp
# iteration channel.
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_MDIO_SUN4I=y
CONFIG_MOTORCOMM_PHY=y
# USB-Ethernet dongles still work as a fallback. Carried over from the
# reference, where the r8152 was the only way in.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# --- USB ---------------------------------------------------------------
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_SUNXI=y

# --- Input: DualShock 3, wired and over Bluetooth -----------------------
# Carried over from the reference. See its linux-retrogaming.config for the
# full story; the short version:
#   HIDRAW - the BlueZ sixaxis plugin pairs a DS3 through /dev/hidraw*
#   UHID   - BlueZ 5 creates BT HID input devices through /dev/uhid, not HIDP.
#            Without it the pad "connects" and no js0/event node appears.
CONFIG_USB_HID=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_FF_MEMLESS=y
# Synthetic input for automated on-target testing (tools/inject-input.c).
CONFIG_INPUT_UINPUT=y

# --- Bluetooth ----------------------------------------------------------
# The onboard UWE5622 needs an out-of-tree driver (Armbian's uwe5622
# extension). That is deferred, so Bluetooth for now means a USB dongle. btusb
# covers the common CSR/Realtek/Broadcom/Intel sticks.
# BT cannot be built in while RFKILL is a module (arm64 defconfig: =m), so BT
# silently came out =m in build #1. Same trap as CONFIG_SOUND above.
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
# btusb MUST be a module. Realtek dongles need firmware (rtl_bt/*), and
# built-in btusb probes the USB device before the rootfs is mounted, so the
# firmware request fails. The reference hit exactly this with brcmfmac and
# hci_bcm. As a module, udev loads it after /lib/firmware exists.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y

# --- Filesystems --------------------------------------------------------
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
