From: RetroOPI_Z3
Subject: [PATCH] sh4 dynarec: per-game idle loop hints (Metropolis Street Racer)

Metropolis Street Racer waits for an event flag in a loop that calls an
event dispatcher every spin (table -> empty callback): ~55% of the SH4
thread in a race, which ran at ~70%. 0001's static check cannot prove
such a loop (it allows calls only to "rts; nop"); a general extension
that followed calls changed timing in other games (bad sound reported in
Sega Rally 2 and V-Rally while it was installed), so this is a list of
measured loops instead: game ID, exact loop range and first opcode.
Listed loops get the same treatment as detected ones (the back-edge
block is charged a timeslice; nothing is skipped).
FLYCAST_THREADED_AUDIO=0 forces the lockstep AICA (0007), so that the
audio speed meter shows the emulation speed again for benchmarks.

diff -ruN a/core/hw/sh4/dyna/decoder.cpp b/core/hw/sh4/dyna/decoder.cpp
--- a/core/hw/sh4/dyna/decoder.cpp	2026-10-06 23:03:21.722606546 +0300
+++ b/core/hw/sh4/dyna/decoder.cpp	2026-10-06 23:03:21.726808904 +0300
@@ -1175,6 +1175,31 @@
 	return (anyWritten & readFirst) == 0;
 }
 
+// Idle loops the static check cannot prove, measured one by one: listed by
+// game ID, exact loop range and the loop's first opcode (so a different
+// revision or an overlay at the same address never matches). Each one only
+// gets its back-edge block charged a timeslice, like a detected loop.
+static const struct
+{
+	const char *gameId;
+	u32 start, end;
+	u16 firstOp;
+} idleLoopHints[] = {
+	// Metropolis Street Racer: waits for an event flag, calling an event
+	// dispatcher (table -> empty callback) every spin: ~55% of the SH4 thread
+	// in a race.
+	{ "MK-51012", 0x8c12b980, 0x8c12b9b0, 0x4a0b },
+};
+
+static bool idleLoopHinted(u32 start, u32 end)
+{
+	for (const auto& h : idleLoopHints)
+		if (h.start == start && h.end == end && settings.content.gameId == h.gameId
+				&& IReadMem16(start) == h.firstOp)
+			return true;
+	return false;
+}
+
 bool dec_DecodeBlock(RuntimeBlockInfo* rbi,u32 max_cycles)
 {
 	blk=rbi;
@@ -1294,7 +1319,8 @@
 	if ((blk->BlockType == BET_Cond_0 || blk->BlockType == BET_Cond_1 || blk->BlockType == BET_StaticJump)
 			&& blk->BranchBlock != NullAddress && blk->BranchBlock <= blk->vaddr
 			&& blk->vaddr - blk->BranchBlock <= 64 && idleSkipEnabled()
-			&& dec_isIdleLoop(blk->BranchBlock, blk->vaddr + blk->sh4_code_size))
+			&& (dec_isIdleLoop(blk->BranchBlock, blk->vaddr + blk->sh4_code_size)
+				|| idleLoopHinted(blk->BranchBlock, blk->vaddr + blk->sh4_code_size)))
 	{
 		NOTICE_LOG(DYNAREC, "Idle loop %08x-%08x: back-edge block %08x charged %d cycles (was %d)",
 				blk->BranchBlock, blk->vaddr + blk->sh4_code_size, blk->vaddr, SH4_TIMESLICE, blk->guest_cycles);
diff -ruN a/shell/libretro/libretro.cpp b/shell/libretro/libretro.cpp
--- a/shell/libretro/libretro.cpp	2026-10-06 23:03:21.726808904 +0300
+++ b/shell/libretro/libretro.cpp	2026-10-06 23:03:21.726808904 +0300
@@ -871,6 +871,10 @@
 	var.key = CORE_OPTION_NAME "_threaded_audio";
 	aica::threadedOption = !(environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value
 			&& !strcmp(var.value, "disabled"));
+	// FLYCAST_THREADED_AUDIO=0 forces the lockstep AICA, e.g. to benchmark: the
+	// audio speed meter then shows the emulation speed again
+	if (const char *s = getenv("FLYCAST_THREADED_AUDIO"))
+		aica::threadedOption = s[0] != '0';
 
 	var.key = CORE_OPTION_NAME "_per_content_vmus";
 	unsigned previous_per_content_vmus = per_content_vmus;
