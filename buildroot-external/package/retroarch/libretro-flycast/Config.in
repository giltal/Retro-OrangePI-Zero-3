config BR2_PACKAGE_LIBRETRO_FLYCAST
	bool "libretro-flycast"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_ZLIB
	help
	  Flycast: Sega Dreamcast, NAOMI and Atomiswave emulator,
	  libretro core. Hardware rendering through GLES3.

	  https://github.com/flyinghead/flycast

comment "libretro-flycast needs a toolchain w/ C++ and GLES"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HAS_LIBGLES
