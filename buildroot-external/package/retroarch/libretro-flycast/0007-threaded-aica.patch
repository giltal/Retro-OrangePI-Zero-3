diff -ruN a/core/hw/aica/aica.cpp b/core/hw/aica/aica.cpp
--- a/core/hw/aica/aica.cpp	2026-10-05 17:50:46.120895255 +0300
+++ b/core/hw/aica/aica.cpp	2026-10-05 17:50:46.124895255 +0300
@@ -8,9 +8,37 @@
 #include "hw/arm7/arm7.h"
 #include "hw/arm7/arm_mem.h"
 
+#include <atomic>
+#include <chrono>
+#include <thread>
+#ifdef __linux__
+#include <pthread.h>
+#endif
+
+#ifdef LIBRETRO
+size_t retro_audio_buffered_frames();
+#endif
+
 namespace aica
 {
 
+// Threaded AICA: the ARM7 and the sample generation run on their own thread,
+// paced by the wall clock at 44.1 kHz, instead of one sample per AICA_TICK of
+// SH4 time. When the SH4 runs below full speed (Windows CE games), the sound
+// keeps playing at the right rate instead of breaking up, and the SH4 thread
+// sheds the ARM7 and the mixing. The SH4 reaches the AICA through
+// readAicaReg/writeAicaReg and (de)serialize, which take `mutex`; the thread
+// holds it while it runs a chunk of samples. SH4 interrupts raised on the
+// AICA thread are delivered by the SH4 thread in AicaUpdate.
+bool threadedOption;
+std::recursive_mutex mutex;
+static std::thread thread;
+static std::atomic<bool> threadRunning;
+static std::atomic<bool> threadStop;
+static std::atomic<u32> sh4Heartbeat;
+static std::atomic<bool> sh4IntsPending;
+static thread_local bool onAicaThread;
+
 #define SH4_IRQ_BIT (1 << (holly_SPU_IRQ & 31))
 
 std::deque<u8> midiSendBuffer;
@@ -65,6 +93,12 @@
 static bool UpdateSh4Ints()
 {
 	u32 p_ints = MCIEB->full & MCIPD->full;
+	if (onAicaThread)
+	{
+		// the holly interrupt state belongs to the SH4 thread: see AicaUpdate
+		sh4IntsPending = true;
+		return p_ints != 0;
+	}
 	if (p_ints)
 	{
 		if ((SB_ISTEXT & SH4_IRQ_BIT) == 0)
@@ -84,8 +118,93 @@
 int aica_schid = -1;
 constexpr int AICA_TICK = 4535;		// 44.1 KHz
 
+static void threadLoop()
+{
+	using namespace std::chrono;
+	constexpr u32 Chunk = 8;			// samples per lock
+	constexpr u64 MaxLag = 44100 / 10;	// don't catch up on more than 100 ms
+	onAicaThread = true;
+#ifdef __linux__
+	pthread_setname_np(pthread_self(), "Flycast-aica");
+#endif
+	auto start = steady_clock::now();
+	u64 generated = 0;
+	u32 lastBeat = sh4Heartbeat;
+	auto lastBeatTime = start;
+	while (!threadStop)
+	{
+		auto now = steady_clock::now();
+		u32 beat = sh4Heartbeat.load(std::memory_order_relaxed);
+		if (beat != lastBeat)
+		{
+			lastBeat = beat;
+			lastBeatTime = now;
+		}
+		// Pause with the SH4 (menu, savestate), or if the frontend stops taking audio
+		bool paused = now - lastBeatTime > milliseconds(100);
+#ifdef LIBRETRO
+		paused = paused || retro_audio_buffered_frames() > 8192;
+#endif
+		if (paused)
+		{
+			std::this_thread::sleep_for(milliseconds(2));
+			start = steady_clock::now();
+			generated = 0;
+			continue;
+		}
+		u64 due = (u64)duration_cast<microseconds>(now - start).count() * 441 / 10000;
+		if (generated >= due)
+		{
+			std::this_thread::sleep_for(milliseconds(1));
+			continue;
+		}
+		if (due - generated > MaxLag)
+			generated = due - Chunk;
+		{
+			std::lock_guard<std::recursive_mutex> lock(mutex);
+			arm::run(Chunk);
+		}
+		generated += Chunk;
+	}
+	onAicaThread = false;
+}
+
+static void startThread()
+{
+	threadStop = false;
+	sh4IntsPending = false;
+	threadRunning = true;
+	thread = std::thread(threadLoop);
+	NOTICE_LOG(AICA, "AICA running on its own thread");
+}
+
+void stopThread()
+{
+	if (!threadRunning)
+		return;
+	threadStop = true;
+	thread.join();
+	threadRunning = false;
+	if (sh4IntsPending.exchange(false))
+		UpdateSh4Ints();
+}
+
 static int AicaUpdate(int tag, int cycles, int jitter, void *arg)
 {
+	if (threadedOption != threadRunning)
+	{
+		if (threadedOption)
+			startThread();
+		else
+			stopThread();
+	}
+	if (threadRunning)
+	{
+		sh4Heartbeat.fetch_add(1, std::memory_order_relaxed);
+		if (sh4IntsPending.exchange(false))
+			UpdateSh4Ints();
+		return AICA_TICK;
+	}
 	arm::run(1);
 
 	return AICA_TICK;
@@ -258,6 +377,7 @@
 
 void reset(bool hard)
 {
+	stopThread();
 	if (hard)
 	{
 		initMem();
@@ -273,6 +393,7 @@
 
 void term()
 {
+	stopThread();
 	arm::term();
 	sgc::term();
 	termMem();
