config BR2_PACKAGE_LIBRETRO_PPSSPP
	bool "libretro-ppsspp"
	depends on BR2_PACKAGE_RETROARCH
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_ZLIB
	help
	  PPSSPP: Sony PlayStation Portable emulator, libretro core
	  (upstream hrydgard/ppsspp). Hardware rendering through GLES3.

	  https://www.ppsspp.org

comment "libretro-ppsspp needs a toolchain w/ C++ and GLES"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HAS_LIBGLES
